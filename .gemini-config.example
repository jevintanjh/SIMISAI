# SIMISAI Gemini CLI Configuration
# Quick reference for Gemini CLI usage
# Copy this file to .gemini-config and add your API key

# Environment setup (use in shell)
export GEMINI_API_KEY="your_gemini_api_key_here"

# Basic usage
# gemini "your question here"
# gemini -f file.txt "analyze this file"

# For SIMISAI medical device development
# gemini "Research [MEDICAL_DEVICE] usage patterns for accessibility"
# gemini "Analyze medical device detection accuracy requirements"
# gemini "Review multilingual medical content for cultural appropriateness"

# Get your API key from: https://makersuite.google.com/app/apikey
